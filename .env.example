# The contact form uses the visitor's email client by default (mailto:).
# Leave the following unset for your first deployment.
# Configure the Cloudflare Pages Function and email provider before enabling it.
# NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_public_site_key
#
# The following are Cloudflare Pages server-side environment settings, NOT public keys.
# Set them only in the Cloudflare dashboard, never commit real credentials.
# RESEND_API_KEY=secret
# CONTACT_FROM=NYVEX <contact@your-verified-domain.example>
# CONTACT_TO=dimasavva63@gmail.com
# TURNSTILE_SECRET_KEY=secret
